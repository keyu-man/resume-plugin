{
  "id": "resume-plugin",
  "name": "Resume Plugin",
  "description": "Resume templating + import helpers (render DOCX from template.docx + data.json).",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "greeting": {
        "type": "string",
        "default": "Hello from resume-plugin!"
      },
      "shout": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "uiHints": {
    "greeting": {
      "label": "Greeting",
      "placeholder": "Hello from resume-plugin!"
    },
    "shout": {
      "label": "Uppercase responses"
    }
  }
}
